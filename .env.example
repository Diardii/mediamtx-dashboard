# MediaMTX Dashboard Configuration

# MediaMTX API URL (default bridge-network Docker Compose deployment)
MEDIAMTX_API_URL=http://mediamtx:9997

# Node Exporter URL (host-network mode; docker-compose.host.yml)
NODE_EXPORTER_URL=http://127.0.0.1:9100

# Use mock data instead of real MediaMTX (true/false)
USE_MOCK=false

# API Server
API_HOST=0.0.0.0
API_PORT=8000
