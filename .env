# ===== MediaMTX =====
# Alamat API MediaMTX (pastikan api: yes di mediamtx.yml)
MEDIAMTX_API_URL=http://localhost:9997

# Kosongkan jika MediaMTX tidak memakai user/password untuk API
MEDIAMTX_API_USER=
MEDIAMTX_API_PASS=

# Alamat untuk link tonton stream (dipakai frontend)
MEDIAMTX_WEBRTC_URL=http://localhost:8889
MEDIAMTX_HLS_URL=http://localhost:8888
MEDIAMTX_RTSP_URL=rtsp://localhost:8554

# true = pakai data tiruan, tidak memanggil MediaMTX
USE_MOCK=false

# ===== Database =====
# File SQLite, dibuat otomatis
DATABASE_PATH=data.db
# Tiap berapa detik kamera yang hilang didaftarkan ulang ke MediaMTX (0 = mati)
SYNC_INTERVAL_SECONDS=30

# ===== Login =====
# Isi dengan teks acak panjang. Buat dengan perintah:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=b431db9d96604b03b83742dedc89efe18f74caa276da92de0a7e21c0632dd76d
# Lama sesi login (menit)
TOKEN_EXPIRE_MINUTES=480
# Akun admin pertama, hanya dipakai saat database masih kosong
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== Frontend =====
# Asal frontend yang diizinkan (CORS), pisahkan dengan koma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
